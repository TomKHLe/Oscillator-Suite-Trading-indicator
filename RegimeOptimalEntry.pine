// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © Regime Optimal Entry System
//
// REGIME-FILTERED OPTIMAL ENTRY SYSTEM (ROES)
// ============================================
// A high-probability trading system combining:
// 1. Hurst Exponent Regime Filter - Only trades in mathematically favorable regimes
// 2. Optimal Stopping Theory - Secretary problem applied to entry timing
// 3. Ornstein-Uhlenbeck Mean Reversion - Statistical mean reversion model
// 4. ATR-Keltner Dynamic SL/TP - Volatility-adjusted risk management
// 5. Kelly Criterion Position Sizing - Optimal bet sizing
//
// KEY PRINCIPLE: Fewer signals, higher probability
// This system will NOT signal in unfavorable conditions

//@version=6
indicator("Regime Optimal Entry System", "ROES", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// INPUTS
// ============================================================================
group_regime = "══════ REGIME DETECTION ══════"
hurst_length = input.int(100, "Hurst Calculation Period", minval=50, maxval=300, group=group_regime)
regime_threshold_mr = input.float(0.45, "Mean Reversion Threshold (H<)", minval=0.3, maxval=0.5, step=0.01, group=group_regime)
regime_threshold_trend = input.float(0.55, "Trending Threshold (H>)", minval=0.5, maxval=0.7, step=0.01, group=group_regime)
regime_confirm_bars = input.int(3, "Regime Confirmation Bars", minval=1, maxval=10, group=group_regime)

group_entry = "══════ OPTIMAL ENTRY ══════"
ou_length = input.int(20, "OU Mean Period", minval=10, maxval=100, group=group_entry)
ou_threshold = input.float(2.0, "OU Deviation Threshold (σ)", minval=1.0, maxval=4.0, step=0.1, group=group_entry)
optimal_stop_n = input.int(37, "Optimal Stopping % (Secretary)", minval=20, maxval=50, group=group_entry, tooltip="Based on 1/e ≈ 37% - optimal stopping point")
lookback_window = input.int(50, "Lookback Window for Optimal Stop", minval=20, maxval=200, group=group_entry)

group_risk = "══════ RISK MANAGEMENT ══════"
atr_length = input.int(14, "ATR Period", minval=5, maxval=50, group=group_risk)
sl_atr_mult = input.float(2.0, "Stop Loss ATR Multiplier", minval=0.5, maxval=5.0, step=0.1, group=group_risk)
tp_atr_mult = input.float(3.0, "Take Profit ATR Multiplier", minval=1.0, maxval=10.0, step=0.1, group=group_risk)
use_dynamic_tp = input.bool(true, "Use Dynamic TP (Mean Target)", group=group_risk)
trail_after_tp1 = input.bool(true, "Trail Stop After TP1", group=group_risk)

group_kelly = "══════ KELLY CRITERION ══════"
kelly_fraction = input.float(0.25, "Kelly Fraction (Conservative)", minval=0.1, maxval=0.5, step=0.05, group=group_kelly, tooltip="Use 25% Kelly for safety")
win_rate_estimate = input.float(0.55, "Estimated Win Rate", minval=0.4, maxval=0.8, step=0.01, group=group_kelly)
avg_win_loss_ratio = input.float(1.5, "Avg Win/Loss Ratio", minval=1.0, maxval=5.0, step=0.1, group=group_kelly)

group_visual = "══════ VISUALIZATION ══════"
show_sl_tp = input.bool(true, "Show SL/TP Levels", group=group_visual)
show_regime_label = input.bool(true, "Show Regime Label", group=group_visual)
show_entry_zone = input.bool(true, "Show Entry Zone", group=group_visual)
show_signals = input.bool(true, "Show Entry Signals", group=group_visual)

// ============================================================================
// CORE CALCULATIONS
// ============================================================================

// --- Log Returns ---
returns = math.log(close / close[1])

// ============================================================================
// 1. HURST EXPONENT - REGIME DETECTION
// ============================================================================
// R/S Analysis for regime classification

calculate_rs(length) =>
    mean_ret = ta.sma(returns, length)
    var float cum_dev = 0.0
    var float max_cum = -1e10
    var float min_cum = 1e10
    cum_dev := 0.0
    max_cum := -1e10
    min_cum := 1e10
    for i = 0 to length - 1
        cum_dev := cum_dev + (returns[i] - mean_ret)
        max_cum := math.max(max_cum, cum_dev)
        min_cum := math.min(min_cum, cum_dev)
    R = max_cum - min_cum
    S = ta.stdev(returns, length)
    R / math.max(S, 1e-10)

// Multi-scale R/S
rs_20 = calculate_rs(20)
rs_40 = calculate_rs(40)
rs_60 = calculate_rs(60)
rs_80 = calculate_rs(math.min(80, hurst_length))

// Linear regression for Hurst
log_n_20 = math.log(20.0)
log_n_40 = math.log(40.0)
log_n_60 = math.log(60.0)
log_n_80 = math.log(80.0)

log_rs_20 = math.log(math.max(rs_20, 1e-10))
log_rs_40 = math.log(math.max(rs_40, 1e-10))
log_rs_60 = math.log(math.max(rs_60, 1e-10))
log_rs_80 = math.log(math.max(rs_80, 1e-10))

mean_log_n = (log_n_20 + log_n_40 + log_n_60 + log_n_80) / 4
mean_log_rs = (log_rs_20 + log_rs_40 + log_rs_60 + log_rs_80) / 4

cov_term = (log_n_20 - mean_log_n) * (log_rs_20 - mean_log_rs) + (log_n_40 - mean_log_n) * (log_rs_40 - mean_log_rs) + (log_n_60 - mean_log_n) * (log_rs_60 - mean_log_rs) + (log_n_80 - mean_log_n) * (log_rs_80 - mean_log_rs)

var_term = math.pow(log_n_20 - mean_log_n, 2) + math.pow(log_n_40 - mean_log_n, 2) + math.pow(log_n_60 - mean_log_n, 2) + math.pow(log_n_80 - mean_log_n, 2)

hurst_raw = cov_term / math.max(var_term, 1e-10)
hurst = ta.sma(math.max(0.0, math.min(1.0, hurst_raw)), 5)

// Regime classification with confirmation
is_mean_reverting_raw = hurst < regime_threshold_mr
is_trending_raw = hurst > regime_threshold_trend
is_random_walk = not is_mean_reverting_raw and not is_trending_raw

// Require N consecutive bars for regime confirmation
mr_count = ta.barssince(not is_mean_reverting_raw)
trend_count = ta.barssince(not is_trending_raw)

is_mean_reverting = mr_count >= regime_confirm_bars
is_trending = trend_count >= regime_confirm_bars

// ============================================================================
// 2. ORNSTEIN-UHLENBECK MEAN REVERSION MODEL
// ============================================================================
// dX = θ(μ - X)dt + σdW
// Price tends to revert to mean with speed θ

ou_mean = ta.sma(close, ou_length)
ou_std = ta.stdev(close, ou_length)

// Deviation from mean in standard deviations
ou_zscore = (close - ou_mean) / math.max(ou_std, 1e-10)

// Mean reversion speed (theta) estimation
// Higher when price consistently reverts
price_change = close - close[1]
mean_direction = ou_mean - ou_mean[1]
reversion_strength = ta.correlation(ou_zscore[1], -price_change, ou_length)
theta = math.max(0, reversion_strength)

// Half-life of mean reversion (how many bars to revert 50%)
half_life = theta > 0.1 ? math.log(2) / theta : 999

// ============================================================================
// 3. OPTIMAL STOPPING THEORY (SECRETARY PROBLEM)
// ============================================================================
// After observing n/e candidates, select the next one better than all previous
// This gives ~37% probability of selecting the best

// For trading: observe price extremes, then enter when price exceeds threshold

// Calculate the observation phase threshold
observe_bars = int(lookback_window * optimal_stop_n / 100)

// Track best prices during observation phase
var float best_low_observed = na
var float best_high_observed = na
var int bars_since_signal = 0

// Rolling window extremes
window_high = ta.highest(high, lookback_window)
window_low = ta.lowest(low, lookback_window)
observe_high = ta.highest(high, observe_bars)
observe_low = ta.lowest(low, observe_bars)

// Optimal stopping condition:
// After observation phase, enter if price exceeds observed extremes
// AND we're in the correct regime

// For LONG: Price drops below observation phase low in mean-reverting regime
optimal_long_condition = low < observe_low[1] and low <= window_low[observe_bars]

// For SHORT: Price rises above observation phase high in mean-reverting regime
optimal_short_condition = high > observe_high[1] and high >= window_high[observe_bars]

// ============================================================================
// 4. ATR-BASED DYNAMIC SL/TP
// ============================================================================

atr = ta.atr(atr_length)

// Volatility regime adjustment
atr_sma = ta.sma(atr, 50)
vol_regime = atr / atr_sma  // >1 = high vol, <1 = low vol

// Adjust multipliers based on volatility regime
// Tighter stops in low vol, wider in high vol
sl_mult_adjusted = sl_atr_mult * math.max(0.7, math.min(1.5, vol_regime))
tp_mult_adjusted = tp_atr_mult * math.max(0.7, math.min(1.5, vol_regime))

// Calculate SL/TP levels
long_sl = close - atr * sl_mult_adjusted
long_tp1 = close + atr * tp_mult_adjusted
long_tp_mean = ou_mean  // Dynamic TP at mean

short_sl = close + atr * sl_mult_adjusted
short_tp1 = close - atr * tp_mult_adjusted
short_tp_mean = ou_mean  // Dynamic TP at mean

// ============================================================================
// 5. KELLY CRITERION POSITION SIZING
// ============================================================================
// f* = (p*b - q) / b
// where p = win probability, q = 1-p, b = win/loss ratio

kelly_full = (win_rate_estimate * avg_win_loss_ratio - (1 - win_rate_estimate)) / avg_win_loss_ratio
kelly_optimal = math.max(0, kelly_full * kelly_fraction)  // Fractional Kelly for safety

// Adjust Kelly based on signal quality
signal_quality_mr = is_mean_reverting ? math.abs(ou_zscore) / ou_threshold : 0
kelly_adjusted = kelly_optimal * math.min(1.0, signal_quality_mr)

// ============================================================================
// 6. ENTRY SIGNALS - COMBINED CONDITIONS
// ============================================================================

// LONG SIGNAL CONDITIONS:
// 1. Mean-reverting regime (Hurst < threshold)
// 2. Price significantly below mean (OU z-score < -threshold)
// 3. Optimal stopping condition met
// 4. Not already in a signal cooldown

long_regime_ok = is_mean_reverting
long_ou_ok = ou_zscore < -ou_threshold
long_optimal_ok = optimal_long_condition or (ou_zscore < -(ou_threshold * 1.5))  // Extra deviation overrides

long_signal = long_regime_ok and long_ou_ok and show_signals

// SHORT SIGNAL CONDITIONS:
short_regime_ok = is_mean_reverting
short_ou_ok = ou_zscore > ou_threshold
short_optimal_ok = optimal_short_condition or (ou_zscore > (ou_threshold * 1.5))

short_signal = short_regime_ok and short_ou_ok and show_signals

// Trending regime signals (different logic - momentum based)
trend_long = is_trending and ta.crossover(close, ta.sma(close, 20)) and ta.mom(close, 10) > 0
trend_short = is_trending and ta.crossunder(close, ta.sma(close, 20)) and ta.mom(close, 10) < 0

// ============================================================================
// 7. SIGNAL STATE TRACKING
// ============================================================================

var int signal_state = 0  // 0 = none, 1 = long, -1 = short
var float entry_price = na
var float stop_loss = na
var float take_profit1 = na
var float take_profit2 = na
var bool tp1_hit = false

// New signal detection
new_long = long_signal and signal_state != 1
new_short = short_signal and signal_state != -1

// Update state on new signals
if new_long
    signal_state := 1
    entry_price := close
    stop_loss := long_sl
    take_profit1 := long_tp1
    take_profit2 := use_dynamic_tp ? long_tp_mean : long_tp1 * 1.5
    tp1_hit := false

if new_short
    signal_state := -1
    entry_price := close
    stop_loss := short_sl
    take_profit1 := short_tp1
    take_profit2 := use_dynamic_tp ? short_tp_mean : short_tp1 * 1.5
    tp1_hit := false

// Check for SL/TP hits
if signal_state == 1
    if low <= stop_loss
        signal_state := 0
    if high >= take_profit1 and not tp1_hit
        tp1_hit := true
        if trail_after_tp1
            stop_loss := entry_price  // Move to breakeven
    if high >= take_profit2
        signal_state := 0

if signal_state == -1
    if high >= stop_loss
        signal_state := 0
    if low <= take_profit1 and not tp1_hit
        tp1_hit := true
        if trail_after_tp1
            stop_loss := entry_price  // Move to breakeven
    if low <= take_profit2
        signal_state := 0

// ============================================================================
// 8. VISUALIZATION
// ============================================================================

// Colors
color_long = color.new(#00E676, 0)
color_short = color.new(#FF5252, 0)
color_sl = color.new(#FF1744, 0)
color_tp1 = color.new(#00E5FF, 0)
color_tp2 = color.new(#76FF03, 0)
color_mean = color.new(#FFC107, 50)
color_entry_zone_bull = color.new(#00E676, 85)
color_entry_zone_bear = color.new(#FF5252, 85)

// Mean line
plot(ou_mean, "OU Mean", color_mean, 2)

// Entry zone bands (areas where signals can trigger)
upper_entry_zone = ou_mean + ou_std * ou_threshold
lower_entry_zone = ou_mean - ou_std * ou_threshold
upper_extreme = ou_mean + ou_std * (ou_threshold * 1.5)
lower_extreme = ou_mean - ou_std * (ou_threshold * 1.5)

p_upper = plot(show_entry_zone ? upper_entry_zone : na, "Upper Entry Zone", color.new(#FF5252, 70), 1)
p_lower = plot(show_entry_zone ? lower_entry_zone : na, "Lower Entry Zone", color.new(#00E676, 70), 1)
plot(show_entry_zone ? upper_extreme : na, "Upper Extreme", color.new(#FF5252, 50), 1, plot.style_circles)
plot(show_entry_zone ? lower_extreme : na, "Lower Extreme", color.new(#00E676, 50), 1, plot.style_circles)

// Fill entry zones
fill(p_upper, p_lower, color.new(#607D8B, 95), title="Neutral Zone")

// SL/TP Lines (only when in position)
plot(show_sl_tp and signal_state != 0 ? stop_loss : na, "Stop Loss", color_sl, 2, plot.style_linebr)
plot(show_sl_tp and signal_state != 0 ? take_profit1 : na, "Take Profit 1", color_tp1, 2, plot.style_linebr)
plot(show_sl_tp and signal_state != 0 and use_dynamic_tp ? take_profit2 : na, "Take Profit 2 (Mean)", color_tp2, 2, plot.style_linebr)
plot(show_sl_tp and signal_state != 0 ? entry_price : na, "Entry Price", color.white, 1, plot.style_linebr)

// Entry signals
plotshape(new_long, "Long Entry", shape.triangleup, location.belowbar, color_long, size=size.normal)
plotshape(new_short, "Short Entry", shape.triangledown, location.abovebar, color_short, size=size.normal)

// Trending regime signals (smaller, different shape)
plotshape(trend_long and show_signals, "Trend Long", shape.circle, location.belowbar, color.new(#2196F3, 0), size=size.tiny)
plotshape(trend_short and show_signals, "Trend Short", shape.circle, location.abovebar, color.new(#2196F3, 0), size=size.tiny)

// Background color for regime
regime_bg = is_mean_reverting ? color.new(#9C27B0, 92) : is_trending ? color.new(#2196F3, 92) : color.new(#607D8B, 95)
bgcolor(regime_bg, title="Regime Background")

// ============================================================================
// 9. INFORMATION TABLE
// ============================================================================

var table info = table.new(position.top_right, 2, 12, bgcolor=color.new(#1E1E1E, 10), border_width=1)

if barstate.islast
    // Regime
    regime_text = is_mean_reverting ? "MEAN REVERT ✓" : is_trending ? "TRENDING" : "RANDOM WALK"
    regime_color = is_mean_reverting ? color_long : is_trending ? color.new(#2196F3, 0) : color.gray

    // Signal status
    signal_text = signal_state == 1 ? "LONG ACTIVE" : signal_state == -1 ? "SHORT ACTIVE" : "NO POSITION"
    signal_color = signal_state == 1 ? color_long : signal_state == -1 ? color_short : color.gray

    // Risk/Reward if in position
    rr_text = "N/A"
    if signal_state != 0 and not na(entry_price) and not na(stop_loss) and not na(take_profit1)
        risk = math.abs(entry_price - stop_loss)
        reward = math.abs(take_profit1 - entry_price)
        rr = reward / math.max(risk, 1e-10)
        rr_text := str.tostring(rr, "#.##") + ":1"

    table.cell(info, 0, 0, "ROES DASHBOARD", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "", text_color=color.white)

    table.cell(info, 0, 1, "Regime:", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 1, regime_text, text_color=regime_color, text_size=size.tiny)

    table.cell(info, 0, 2, "Hurst:", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 2, str.tostring(hurst, "#.###"), text_color=color.white, text_size=size.tiny)

    table.cell(info, 0, 3, "OU Z-Score:", text_color=color.gray, text_size=size.tiny)
    zscore_color = math.abs(ou_zscore) > ou_threshold ? (ou_zscore > 0 ? color_short : color_long) : color.white
    table.cell(info, 1, 3, str.tostring(ou_zscore, "#.##"), text_color=zscore_color, text_size=size.tiny)

    table.cell(info, 0, 4, "Half-Life:", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 4, str.tostring(half_life, "#.#") + " bars", text_color=color.white, text_size=size.tiny)

    table.cell(info, 0, 5, "ATR:", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 5, str.tostring(atr, "#.####"), text_color=color.white, text_size=size.tiny)

    table.cell(info, 0, 6, "Vol Regime:", text_color=color.gray, text_size=size.tiny)
    vol_text = vol_regime > 1.2 ? "HIGH" : vol_regime < 0.8 ? "LOW" : "NORMAL"
    vol_color = vol_regime > 1.2 ? color_short : vol_regime < 0.8 ? color_long : color.white
    table.cell(info, 1, 6, vol_text, text_color=vol_color, text_size=size.tiny)

    table.cell(info, 0, 7, "─────────", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 7, "─────────", text_color=color.gray, text_size=size.tiny)

    table.cell(info, 0, 8, "Position:", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 8, signal_text, text_color=signal_color, text_size=size.tiny)

    table.cell(info, 0, 9, "Risk:Reward:", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 9, rr_text, text_color=color.white, text_size=size.tiny)

    table.cell(info, 0, 10, "Kelly Size:", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 10, str.tostring(kelly_adjusted * 100, "#.#") + "%", text_color=color.white, text_size=size.tiny)

    table.cell(info, 0, 11, "TP1 Hit:", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 11, tp1_hit ? "YES ✓" : "NO", text_color=tp1_hit ? color_long : color.gray, text_size=size.tiny)

// ============================================================================
// 10. SIGNAL LABELS WITH SL/TP INFO
// ============================================================================

if new_long
    sl_pct = math.abs(close - long_sl) / close * 100
    tp_pct = math.abs(long_tp1 - close) / close * 100
    label_text = "LONG\nSL: " + str.tostring(long_sl, "#.##") + " (-" + str.tostring(sl_pct, "#.#") + "%)\nTP1: " + str.tostring(long_tp1, "#.##") + " (+" + str.tostring(tp_pct, "#.#") + "%)\nTP2: " + str.tostring(long_tp_mean, "#.##") + " (Mean)"
    label.new(bar_index, low, label_text, style=label.style_label_up, color=color_long, textcolor=color.white, size=size.small)

if new_short
    sl_pct = math.abs(short_sl - close) / close * 100
    tp_pct = math.abs(close - short_tp1) / close * 100
    label_text = "SHORT\nSL: " + str.tostring(short_sl, "#.##") + " (+" + str.tostring(sl_pct, "#.#") + "%)\nTP1: " + str.tostring(short_tp1, "#.##") + " (-" + str.tostring(tp_pct, "#.#") + "%)\nTP2: " + str.tostring(short_tp_mean, "#.##") + " (Mean)"
    label.new(bar_index, high, label_text, style=label.style_label_down, color=color_short, textcolor=color.white, size=size.small)

// ============================================================================
// 11. ALERTS
// ============================================================================

alertcondition(new_long, "Long Entry Signal", "ROES: Long entry signal - Mean reversion buy opportunity")
alertcondition(new_short, "Short Entry Signal", "ROES: Short entry signal - Mean reversion sell opportunity")
alertcondition(trend_long, "Trend Long Signal", "ROES: Trending regime - Long momentum entry")
alertcondition(trend_short, "Trend Short Signal", "ROES: Trending regime - Short momentum entry")
alertcondition(signal_state[1] != 0 and signal_state == 0, "Position Closed", "ROES: Position closed (SL or TP hit)")
alertcondition(tp1_hit and not tp1_hit[1], "TP1 Hit", "ROES: Take Profit 1 reached - Stop moved to breakeven")
alertcondition(ta.cross(hurst, regime_threshold_mr), "Regime Change", "ROES: Regime change detected")
